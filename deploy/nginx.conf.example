# Local component demo. A platform deployment must install authentication upstream.
server {
    listen 8080;
    location /api/agent/face/ {
        proxy_pass http://agent:8765/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        client_max_body_size 44m;
        proxy_connect_timeout 5s;
        proxy_read_timeout 600s;
    }
}
